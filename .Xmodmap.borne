! Remapping des touches pour la borne d'arcade
! Correspond au layout XKB borne
! keycode 10 = touche physique 1 (&) -> f
! keycode 11 = touche physique 2 (é) -> g
! keycode 12 = touche physique 3 (") -> h
! keycode 13 = touche physique 4 (') -> r
! keycode 14 = touche physique 5 (() -> t
! keycode 15 = touche physique 6 (-) -> y
keycode 10 = f F
keycode 11 = g G
keycode 12 = h H
keycode 13 = r R
keycode 14 = t T
keycode 15 = y Y
